# Local configuration and data: they describe YOUR machines and sources.
jezero.toml
*.local.toml
.env
.env.*
!.env.example
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Private denylist used by the pre-commit privacy check.
.privacy-denylist

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Editors and OS
.DS_Store
.idea/
.vscode/
pypi-dist/

# Local leftovers that must never reach a package: config backups, caches, logs.
*.toml.bak-*
.cache/
*.log
